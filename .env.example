# Shared pin comments — Upstash Redis.
# Add via Vercel → Storage / Marketplace → Upstash Redis (free plan); Vercel injects these automatically.
# Local dev: `vercel env pull .env.local` and run `vercel dev` (plain `vite` has no /api and falls back to localStorage).
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=replace-with-token

# Optional: if set, writing comments requires this key (reading stays open). Share it with the team once.
COMMENTS_WRITE_KEY=
